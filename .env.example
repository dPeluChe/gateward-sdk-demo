# Browser (VITE_ prefix → bundled into the client). Never put the API key here.
VITE_GATEWARD_URL=http://localhost:8080
VITE_GATEWARD_APP_ID=<app-uuid>

# Server-side only (no VITE_ prefix → stays in Node, read by the Vite plugin).
GATEWARD_URL=http://localhost:8080
GATEWARD_ISSUER=http://localhost:8080
GATEWARD_APP_ID=<app-uuid>
GATEWARD_API_KEY=<service-account-key-with-events:write>

# Optional environment guard (APP-CONFIG-001): the SDK refuses to register or log in
# if the app behind VITE_GATEWARD_APP_ID runs in a different environment. Use "test"
# while integrating against a shared Core so a QA build can never touch production.
# VITE_GATEWARD_EXPECT_ENV=test
